KIMI_API_KEY=replace_with_your_key
# sk-... keys → Moonshot Open Platform (moonshot-v1-8k / 32k / 128k / auto)
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
# sk-kimi-... keys auto-route to Coding API (kimi-for-coding) even with defaults above

LLM_PROVIDER=kimi

# DeepSeek (only if LLM_PROVIDER=deepseek)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions

# Evidence database for leaf scoring (default: openalex)
# EVIDENCE_PROVIDER=openalex
# EVIDENCE_PROVIDER=semantic-scholar
# EVIDENCE_PROVIDER=arxiv

# OpenAlex (default evidence provider) — free key at https://openalex.org/settings/api
OPENALEX_API_KEY=replace_with_your_key
# Optional legacy contact email (ignored by OpenAlex API since 2026)
# OPENALEX_MAILTO=you@example.com

# Optional — Semantic Scholar API key (1 req/s; app serializes + retries 429)
# SEMANTIC_SCHOLAR_API_KEY=

# MiniMax (only if LLM_PROVIDER=minimax)
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=MiniMax-M3
