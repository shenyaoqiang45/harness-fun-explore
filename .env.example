KIMI_API_KEY=replace_with_your_key
# sk-... keys → Moonshot Open Platform (moonshot-v1-8k / 32k / 128k / auto)
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
# sk-kimi-... keys auto-route to Coding API (kimi-for-coding) even with defaults above

LLM_PROVIDER=kimi

# DeepSeek (only if LLM_PROVIDER=deepseek)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions

# Optional — OpenAlex polite pool (recommended for production)
OPENALEX_MAILTO=you@example.com

# MiniMax (only if LLM_PROVIDER=minimax)
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=MiniMax-M3
